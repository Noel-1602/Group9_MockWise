# Provider choices: mock, groq, ollama, openai
LLM_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# STT choices: whisper, openai, speech_recognition, mock
STT_PROVIDER=mock
WHISPER_MODEL_SIZE=base

# TTS choices: edge-tts, gtts, synth, mock
TTS_PROVIDER=synth
DEFAULT_VOICE=en-US-ChristopherNeural
